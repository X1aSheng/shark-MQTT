// waitForConnCount polls until the broker reports n connected clients, so the
// assertions do not race the accept loop that is still registering the dial.
func waitForConnCount(t *testing.T, b *api.Broker, want int64) {
	t.Helper()
	deadline := time.Now().Add(3 * time.Second)
	for time.Now().Before(deadline) {
		if b.ConnCount() == want {
			return
		}
		time.Sleep(20 * time.Millisecond)
	}
	t.Fatalf("ConnCount() = %d after 3s, want %d", b.ConnCount(), want)
}

// TestDisconnectClient_ClosesSocket covers the operator-facing eviction path:
// a named client is actually removed, and an unknown ClientID is reported as
// such rather than silently accepted.
func TestDisconnectClient_ClosesSocket(t *testing.T) {
	brk := testBroker(t)
	core := brk.Core()

	victim := dialTestBroker(t, brk)
	codec := protocol.NewCodec(0)
	connectSubscriber(t, victim, codec, "disconnect-victim")

	// A second client must be unaffected.
	bystander := dialTestBroker(t, brk)
	bystanderCodec := protocol.NewCodec(0)
	connectSubscriber(t, bystander, bystanderCodec, "disconnect-bystander")

	waitForConnCount(t, brk, 2)

	if !core.DisconnectClient("disconnect-victim") {
		t.Fatal("DisconnectClient(victim) = false, want true for a connected client")
	}
	if core.DisconnectClient("no-such-client") {
		t.Error("DisconnectClient(unknown) = true, want false")
	}

	// The victim's socket must actually be closed: a read has to fail.
	victim.SetReadDeadline(time.Now().Add(3 * time.Second))
	if _, err := codec.Decode(victim); err == nil {
		t.Error("expected a read error on the evicted client's socket")
	}

	// The bystander keeps working.
	if err := bystanderCodec.Encode(bystander, &protocol.PingReqPacket{
		FixedHeader: protocol.FixedHeader{PacketType: protocol.PacketTypePingReq},
	}); err != nil {
		t.Errorf("bystander write after peer eviction failed: %v", err)
	}
	waitForConnCount(t, brk, 1)
}

// TestDisconnectClient_SuppressesWill is the semantic guard. An operator
// evicting a client did not observe a failure, so the Will must NOT fire --
// publishing it would tell every subscriber the client had crashed when in fact
// it was deliberately removed.
func TestDisconnectClient_SuppressesWill(t *testing.T) {
	brk := testBrokerWithRetain(t)

	victim := dialTestBroker(t, brk)
	codec := protocol.NewCodec(0)
	connectWillClient(t, victim, codec, "disconnect-will", protocol.Version50,
		willSpec{topic: "disconnect/will", payload: []byte("should-not-fire"), retain: true})

	waitForConnCount(t, brk, 1)

	if !brk.Core().DisconnectClient("disconnect-will") {
		t.Fatal("DisconnectClient = false, want true")
	}

	// Give any (incorrect) will publication time to land.
	time.Sleep(300 * time.Millisecond)

	// A fresh subscriber must not see a retained will.
	probe := dialTestBroker(t, brk)
	probeCodec := protocol.NewCodec(0)
	connectSubscriber(t, probe, probeCodec, "disconnect-probe")

	probe.SetDeadline(time.Now().Add(2 * time.Second))
	if err := probeCodec.Encode(probe, &protocol.SubscribePacket{
		FixedHeader: protocol.FixedHeader{PacketType: protocol.PacketTypeSubscribe, QoS: 1},
		PacketID:    1,
		Topics:      []protocol.TopicFilter{{Topic: "disconnect/will", QoS: 1}},
	}); err != nil {
		t.Fatalf("SUBSCRIBE: %v", err)
	}
	if _, err := probeCodec.Decode(probe); err != nil {
		t.Fatalf("SUBACK: %v", err)
	}

	probe.SetReadDeadline(time.Now().Add(500 * time.Millisecond))
	pkt, err := probeCodec.Decode(probe)
	if err == nil {
		if pub, ok := pkt.(*protocol.PublishPacket); ok {
			t.Errorf("will was published on operator eviction: topic=%q payload=%q",
				pub.Topic, pub.Payload)
		}
	}
	// A read timeout is the expected outcome: no retained message was delivered.
}

// TestDisconnectAllClients covers the bulk variant used by quota enforcers.
func TestDisconnectAllClients(t *testing.T) {
	brk := testBroker(t)
	core := brk.Core()

	for _, id := range []string{"bulk-1", "bulk-2", "bulk-3"} {
		conn := dialTestBroker(t, brk)
		connectSubscriber(t, conn, protocol.NewCodec(0), id)
	}
	waitForConnCount(t, brk, 3)

	if n := core.DisconnectAllClients(); n != 3 {
		t.Errorf("DisconnectAllClients() = %d, want 3", n)
	}
	waitForConnCount(t, brk, 0)

	// Idempotent: a second call has nothing left to do.
	if n := core.DisconnectAllClients(); n != 0 {
		t.Errorf("DisconnectAllClients() on an idle broker = %d, want 0", n)
	}
}

// TestDisconnectClient_UnstartedBroker makes sure the management call is safe
// before Start, when no connection map exists yet.
func TestDisconnectClient_UnstartedBroker(t *testing.T) {
	cfg := config.DefaultConfig()
	cfg.ListenAddr = ":0"
	cfg.MetricsAddr = ":0"

	brk := api.NewBroker(
		api.WithConfig(cfg),
		api.WithAuth(broker.AllowAllAuth{}),
	)
	core := brk.Core()
	if core.DisconnectClient("anyone") {
		t.Error("DisconnectClient on an unstarted broker = true, want false")
	}
	if n := core.DisconnectAllClients(); n != 0 {
		t.Errorf("DisconnectAllClients on an unstarted broker = %d, want 0", n)
	}
}